{
  "name": "brickwright",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "bootstrap": "node tools/bootstrap.mjs",
    "dev": "hexclave dev --config-file ./hexclave.config.ts -- npm run dev:inner",
    "dev:inner": "node tools/dev.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:api": "node server/index.ts",
    "build": "tsc -b && vite build && node tools/check-dist-budget.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "test": "VITE_HEXCLAVE_PROJECT_ID= VITE_CONVEX_URL= vitest run",
    "test:watch": "VITE_HEXCLAVE_PROJECT_ID= VITE_CONVEX_URL= vitest",
    "test:e2e": "VITE_HEXCLAVE_PROJECT_ID= VITE_CONVEX_URL= node tools/e2e-smoke.mjs",
    "test:e2e:all": "VITE_HEXCLAVE_PROJECT_ID= VITE_CONVEX_URL= node tools/e2e/run-all.mjs",
    "catalog:sources": "node tools/fetch-sources.mjs",
    "catalog:build": "node --max-old-space-size=8192 tools/catalog-compiler.mjs --ldraw .sources/ldraw --shadow .sources/LDCadShadowLibrary-main --rebrickable .sources/rebrickable --out public --version 2026-07 --pack-size 900 --pack-extra 3035,3020,3001,3010,62360,3004,3937,3938,87079,2412b,3070b,60592,60593,60594,60596,60601,38320,60616b,3023b,3024,3005",
    "catalog:fixture": "rm -rf .catalog-fixture && node tools/catalog-compiler.mjs --ldraw tools/fixtures/ldraw --shadow tools/fixtures/shadow --rebrickable tools/fixtures/rebrickable --out .catalog-fixture --version fixture-1",
    "catalog:test-fixture": "node tools/make-test-fixture.mjs",
    "typecheck:convex": "tsc -p convex/tsconfig.json",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "test:live:assistant": "BRICKWRIGHT_LIVE_TESTS=1 vitest run server/assistant/live.test.ts --reporter=verbose",
    "test:live:generation": "BRICKWRIGHT_LIVE_TESTS=1 vitest run server/generation/live.test.ts --reporter=verbose",
    "check": "npm run lint && npm run test && npm run typecheck:convex && npm run typecheck:functions && npm run build",
    "verify:all": "npm run check && npm run test:e2e:all",
    "preview": "vite preview --host 0.0.0.0",
    "serve:api": "node server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@hexclave/js": "1.0.108",
    "@hexclave/react": "1.0.108",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "convex": "1.45.0",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "three": "0.185.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hexclave/cli": "1.0.106",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "three-mesh-bvh": "0.9.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  }
}
