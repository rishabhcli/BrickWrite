{
  "name": "brickwright",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "bootstrap": "node tools/bootstrap.mjs",
    "dev": "hexclave dev --config-file ./hexclave.config.ts -- npm run dev:inner",
    "dev:inner": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tools/e2e-smoke.mjs",
    "catalog:sources": "node tools/fetch-sources.mjs",
    "catalog:build": "node --max-old-space-size=8192 tools/catalog-compiler.mjs --ldraw .sources/ldraw --shadow .sources/LDCadShadowLibrary-main --rebrickable .sources/rebrickable --out public --version 2026-07 --pack-size 900 --pack-extra 3035,3020,3001,3010,62360,3004,3937,3938,87079,2412b,3070b,60592,60593,60594,60596,60601,38320,60616b,3023b,3024,3005",
    "catalog:fixture": "rm -rf .catalog-fixture && node tools/catalog-compiler.mjs --ldraw tools/fixtures/ldraw --shadow tools/fixtures/shadow --rebrickable tools/fixtures/rebrickable --out .catalog-fixture --version fixture-1",
    "catalog:test-fixture": "node tools/make-test-fixture.mjs",
    "check": "npm run test && npm run build",
    "verify:all": "npm run check && npm run test:e2e",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@hexclave/react": "1.0.106",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hexclave/cli": "1.0.106",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "three-mesh-bvh": "0.9.14",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11 <12"
  }
}
