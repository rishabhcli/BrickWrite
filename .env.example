# Browser build configuration (public values; docs/deployment.md)
VITE_HEXCLAVE_PROJECT_ID=
VITE_CONVEX_URL=

# Hexclave server/CLI authentication. Never expose the secret with VITE_*.
HEXCLAVE_PROJECT_ID=
HEXCLAVE_SECRET_SERVER_KEY=
# Trusted Hexclave origin for invitation email; HTTPS unless loopback.
HEXCLAVE_API_URL=
# Same, read first by Convex delivery; takes precedence over the above.
HEXCLAVE_API_URL_SERVER=

# Anthropic-backed assistant and generation (server/** only)
ANTHROPIC_API_KEY=
BRICKWRIGHT_ASSISTANT_MODEL=claude-sonnet-5
BRICKWRIGHT_ASSISTANT_MAX_TOKENS=8192
BRICKWRIGHT_ASSISTANT_MAX_TOOL_TURNS=8
BRICKWRIGHT_ASSISTANT_TIMEOUT_MS=120000
BRICKWRIGHT_GENERATION_MODEL=claude-sonnet-5
BRICKWRIGHT_GENERATION_TIMEOUT_MS=120000

# Node API and Cloudflare-to-Vercel proxy (docs/deployment.md)
# 1 always binds the port, 0 never; unset binds unless VITEST is set.
BRICKWRIGHT_API_LISTEN=
BRICKWRIGHT_API_PORT=8787
BRICKWRIGHT_API_URL=http://127.0.0.1:8787
BRICKWRIGHT_API_ORIGIN=
BRICKWRIGHT_PROXY_SECRET=

# Per-account daily token ceiling (docs/deployment.md). Both or neither:
# half-configured is treated as unconfigured, because checkBudget fails closed
# on a configured store and would then refuse all paid traffic.
BRICKWRIGHT_BUDGET_REDIS_URL=
BRICKWRIGHT_BUDGET_REDIS_TOKEN=

# Publication storage and delivery (docs/integration/share-studio.md)
# Now the *operator* credential, not the only way to write: a normal publisher
# presents a Hexclave session and owns what they publish. Set HEXCLAVE_PROJECT_ID
# on the Pages project too, or no session can be verified.
SHARE_PUBLISH_TOKEN=
SHARE_ORIGIN=http://localhost:4173
SHARE_EMBED_ANCESTORS=
# SHARE_KV and RATE_LIMIT_KV are Cloudflare bindings, not string secrets.
# API_RATE_LIMITER is a [[ratelimits]] binding in wrangler.toml — the atomic
# counter the KV namespace is only a fallback for.

# Invitation delivery from Convex (docs/integration/cloud-projects.md)
INVITATION_EMAIL_ENDPOINT=
INVITATION_EMAIL_TOKEN=
INVITATION_LINK_ORIGIN=http://localhost:4173

# Optional development and acceptance overrides
BRICKWRIGHT_LIVE_TESTS=0
BRICKWRIGHT_GENERATION_PORT=8788
BRICKWRIGHT_E2E_URL=
BRICKWRIGHT_E2E_PORT=4174
# Set to 1 to skip the landing-to-editor handoff in tools/e2e/landing.mjs.
BRICKWRIGHT_E2E_SKIP_EDITOR_HANDOFF=0
# Where tools/e2e/cad-editing.mjs writes screenshots and results.json.
BRICKWRIGHT_CAD_ARTIFACTS=artifacts/cad-editing
BRICKWRIGHT_RENDERER_URL=
BRICKWRIGHT_PREVIEW_PORT=4175
BRICKWRIGHT_LANDING_BUILD_DIR=
SHARE_DEV_PORT=5199
SHARE_DEV_DATA=.share-dev
SHARE_DEV_PROXY=
SHARE_E2E_PORT=5178
SHARE_E2E_DATA=.share-dev/e2e

# Distribution policy overrides (tools/check-dist-budget.mjs)
DIST_TOTAL_BUDGET_BYTES=209715200
DIST_FILE_COUNT_BUDGET=16000
DIST_SINGLE_FILE_BUDGET_BYTES=20971520
