{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "hexclave.config.ts",
    "api",
    "tools",
    "server",
    "src",
    "convex/model/capabilities.ts",
    "convex/model/checksum.ts",
    "convex/model/limits.ts",
    "convex/model/protocol.ts",
    "convex/model/redaction.ts"
  ]
}
